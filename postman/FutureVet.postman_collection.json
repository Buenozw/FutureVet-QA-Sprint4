          }
        },
        {
          "name": "Solicitar consulta em um domingo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Próximo domingo com pelo menos 7 dias de antecedência",
                  "const fmt = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \"0\")}-${String(d.getDate()).padStart(2, \"0\")}`;",
                  "const d = new Date();",
                  "d.setDate(d.getDate() + 7 + ((7 - d.getDay()) % 7));",
                  "pm.collectionVariables.set(\"dataDomingo\", fmt(d));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Mensagem de horário de funcionamento\", () =>",
                  "  pm.expect(pm.response.json().mensagem).to.eql(\"Agendamentos de segunda a sábado, das 08:00 às 18:00.\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
