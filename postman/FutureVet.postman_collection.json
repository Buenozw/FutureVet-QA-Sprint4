            "body": {
              "mode": "raw",
              "raw": "{\n  \"animalId\": {{animalId}},\n  \"tipo\": \"Rotina\",\n  \"data\": \"{{dataConsulta}}\",\n  \"hora\": \"{{horaConsulta}}\",\n  \"local\": \"{{localConsulta}}\"\n}",
              "options": {
