      "name": "02 - Autenticação",
      "description": "Cadastro de tutor e login com JWT.",
      "item": [
        {
          "name": "Cadastrar tutor",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Dados controlados: e-mail e CPF únicos por execução, o resto é fixo",
                  "const ts = Date.now();",
                  "pm.collectionVariables.set(\"emailTutor\", `tutor.qa.${ts}@futurevet.com`);",
                  "pm.collectionVariables.set(\"cpfTutor\", String(ts).slice(-11));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Retorna token JWT do tipo Bearer\", () => {",
                  "  pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.token.split(\".\")).to.have.lengthOf(3);",
                  "  pm.expect(body.tipo).to.eql(\"Bearer\");",
                  "});",
                  "pm.test(\"Conta criada com perfil TUTOR e e-mail informado\", () => {",
                  "  pm.expect(body.role).to.eql(\"TUTOR\");",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get(\"emailTutor\"));",
                  "});",
                  "pm.collectionVariables.set(\"token\", body.token);",
                  "pm.collectionVariables.set(\"usuarioId\", body.usuarioId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
