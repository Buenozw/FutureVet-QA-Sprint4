    {
      "name": "05 - Agenda de consultas",
      "description": "Solicitação de consulta e regras de horário.",
      "item": [
        {
          "name": "Solicitar consulta",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Data futura (30 dias à frente, fora de domingo), hora cheia entre 08:00 e 17:00 e sala única",
                  "const fmt = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \"0\")}-${String(d.getDate()).padStart(2, \"0\")}`;",
                  "const d = new Date();",
                  "d.setDate(d.getDate() + 30);",
                  "if (d.getDay() === 0) d.setDate(d.getDate() + 1);",
                  "pm.collectionVariables.set(\"dataConsulta\", fmt(d));",
                  "pm.collectionVariables.set(\"horaConsulta\", String(8 + Math.floor(Math.random() * 10)).padStart(2, \"0\") + \":00\");",
                  "pm.collectionVariables.set(\"localConsulta\", `Sala QA ${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Devolve o id da consulta\", () => pm.expect(body.id).to.be.a(\"number\").and.above(0));",
                  "pm.collectionVariables.set(\"consultaId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/consultas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "consultas"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"animalId\": {{animalId}},\n  \"tipo\": \"Rotina\",\n  \"data\": \"{{dataConsulta}}\",\n  \"hora\": \"{{horaConsulta}}\",\n  \"local\": \"{{localConsulta}}\",\n  \"observacao\": \"Agendada pelo teste automatizado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Consultar consulta solicitada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Consulta aguardando confirmação (AGENDADA)\", () => pm.expect(body.status).to.eql(\"AGENDADA\"));",
                  "pm.test(\"Data, hora, local e animal corretos\", () => {",
                  "  pm.expect(body.data).to.eql(pm.collectionVariables.get(\"dataConsulta\"));",
                  "  pm.expect(body.hora).to.eql(pm.collectionVariables.get(\"horaConsulta\"));",
                  "  pm.expect(body.local).to.eql(pm.collectionVariables.get(\"localConsulta\"));",
                  "  pm.expect(body.animal).to.eql(\"Thor\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/consultas/{{consultaId}}",
              "host": [
                "{{baseUrl}}"
